# Advanced Threat Detection Configuration
# Configuration for all integrated detection engines

# ============================================================================
# FlowPrint Engine - Device/Application Fingerprinting
# ============================================================================
flowprint:
  enabled: true
  min_flows_for_fingerprint: 5  # Minimum flows to create fingerprint
  clustering_eps: 0.5  # DBSCAN epsilon for destination clustering
  temporal_window: 60  # Time window (seconds) for temporal patterns
  persistence_interval: 10  # Save fingerprints every N new fingerprints

# ============================================================================
# Kitsune Engine - Online Anomaly Detection (Autoencoders)
# ============================================================================
kitsune:
  enabled: true
  ensemble_size: 10  # Number of autoencoders in ensemble
  learning_rate: 0.1  # Learning rate for incremental updates
  anomaly_threshold: 3.0  # Z-score threshold for anomaly detection
  grace_period: 1000  # Number of packets for initial training
  max_host_limit: 255  # Maximum hosts to track
  max_session_limit: 100000  # Maximum sessions to track

# ============================================================================
# ET-BERT Engine - Encrypted Traffic Classification
# ============================================================================
etbert:
  enabled: true
  max_seq_length: 512  # Maximum byte sequence length
  embedding_dim: 64  # Embedding dimension for transformer
  enable_heuristics: true  # Use heuristic rules alongside ML
  min_payload_size: 20  # Minimum payload size to analyze
  classification_threshold: 0.6  # Confidence threshold

# ============================================================================
# Stratosphere IPS - Behavioral Analysis
# ============================================================================
stratosphere:
  enabled: true
  timeslot_duration: 3600  # Time window duration (seconds) - 1 hour default
  min_connections_for_profile: 10  # Minimum connections before profiling
  threat_score_threshold: 0.7  # Threshold for generating alerts
  max_profile_age: 86400  # Maximum profile age (seconds) - 24 hours
  behavior_string_max_length: 1000  # Maximum behavior letter sequence length

# ============================================================================
# Exploit Detection - Vulnerability & Exploit Detection
# ============================================================================
exploit_detection:
  enabled: true
  enable_pattern_matching: true  # Signature-based detection
  enable_anomaly_detection: true  # Anomaly-based detection
  detection_threshold: 0.6  # Confidence threshold for alerts
  
  # Enabled exploit types
  detect_sql_injection: true
  detect_xss: true
  detect_rce: true
  detect_path_traversal: true
  detect_buffer_overflow: true
  detect_ldap_injection: true
  detect_xml_injection: true
  detect_cmd_injection: true
  detect_file_inclusion: true
  detect_exploit_kits: true
  
  # CVE detection
  detect_cves: true
  cve_database_update_interval: 86400  # Update CVE patterns daily

# ============================================================================
# Threat Orchestrator - Combines All Engines
# ============================================================================
threat_orchestrator:
  enabled: true
  
  # Enable/disable individual engines
  enable_flowprint: true
  enable_kitsune: true
  enable_etbert: true
  enable_stratosphere: true
  enable_exploit_detection: true
  enable_ml_models: true
  
  # Threat scoring
  threat_level_weights:
    flowprint_anomaly: 3
    kitsune_anomaly: 8
    etbert_suspicious: 8
    stratosphere_alert: 7
    exploit_detection: 9
    ml_model_threat: 8
  
  # Action thresholds
  critical_threshold: 9  # Threat level >= 9 = CRITICAL
  high_threshold: 7  # Threat level >= 7 = HIGH
  medium_threshold: 5  # Threat level >= 5 = MEDIUM
  
  # Logging
  log_all_assessments: false  # Log all assessments or only threats
  assessment_log_rotation: 7  # Days to keep logs

# ============================================================================
# ML Model Manager Integration
# ============================================================================
ml_models:
  enabled: true
  models_directory: "ml_models"
  
  # Model loading
  auto_load_models: true
  models_to_load:
    - "insider_threat"
    - "ddos_detection"
    - "domain_classifier"
    - "mitm_detection"
  
  # Inference settings
  inference_threshold: 0.7
  batch_inference: false
  max_inference_time_ms: 100

# ============================================================================
# UBA Engine Integration
# ============================================================================
uba:
  enabled: true
  risk_score_threshold: 0.7
  update_interval: 60  # Update profiles every N seconds
  
  # Behavioral thresholds
  night_hours: [22, 6]  # Night hours for after-hours detection
  max_usb_transfers_per_hour: 10
  max_external_emails_per_hour: 50
  max_data_upload_mb_per_hour: 1000

# ============================================================================
# Logging Configuration
# ============================================================================
logging:
  level: "INFO"  # DEBUG, INFO, WARNING, ERROR, CRITICAL
  log_directory: "logs"
  
  # Individual engine logs
  flowprint_log: "flowprint_engine.log"
  kitsune_log: "kitsune_engine.log"
  etbert_log: "etbert_engine.log"
  stratosphere_log: "stratosphere_engine.log"
  exploit_log: "exploit_detection.log"
  orchestrator_log: "threat_orchestrator.log"
  
  # Alert logs
  flowprint_matches: "flowprint_matches.json"
  kitsune_anomalies: "kitsune_anomalies.json"
  etbert_classifications: "etbert_classifications.json"
  stratosphere_alerts: "stratosphere_alerts.json"
  exploit_detections: "exploit_detections.json"
  threat_assessments: "threat_assessments.json"
  
  # Rotation
  max_log_size_mb: 100
  backup_count: 5

# ============================================================================
# Performance Tuning
# ============================================================================
performance:
  # Threading
  max_worker_threads: 4
  queue_max_size: 10000
  
  # Batch processing
  batch_size: 100
  batch_timeout_ms: 1000
  
  # Memory management
  max_memory_mb: 2048
  periodic_cleanup_interval: 300  # Cleanup every 5 minutes
  
  # Profiling
  enable_profiling: false
  profiling_interval: 60

# ============================================================================
# Integration with Existing Components
# ============================================================================
integration:
  # Kafka integration
  kafka_enabled: true
  kafka_threat_topic: "ngfw.threats.advanced"
  kafka_alert_topic: "ngfw.alerts.advanced"
  
  # SOAR integration
  soar_enabled: true
  send_to_soar: true
  soar_priority_filter: "MEDIUM"  # Forward threats >= MEDIUM
  
  # Suricata integration
  suricata_enabled: true
  parse_suricata_eve: true
  enhance_suricata_alerts: true
  
  # Unified logger
  unified_logger_enabled: true
  
  # Firewall integration
  auto_block_enabled: true
  auto_block_threshold: "HIGH"  # Auto-block threats >= HIGH
  block_duration: 3600  # Block duration (seconds)

# ============================================================================
# Database/Storage
# ============================================================================
storage:
  # Fingerprint database
  flowprint_db: "logs/flowprint_fingerprints.pkl"
  
  # Profile storage
  stratosphere_profiles: "logs/stratosphere_profiles.json"
  
  # Model caching
  model_cache_enabled: true
  model_cache_dir: "cache/models"
  
  # Alert history
  alert_retention_days: 30
  alert_db: "logs/alert_history.db"

# ============================================================================
# Reporting
# ============================================================================
reporting:
  # Generate reports
  enable_reports: true
  report_interval: 3600  # Generate report every hour
  report_directory: "reports"
  
  # Report types
  threat_summary: true
  top_attackers: true
  top_targets: true
  threat_timeline: true
  detection_engine_performance: true
  
  # Report formats
  formats: ["json", "html"]

# ============================================================================
# Development/Testing
# ============================================================================
development:
  debug_mode: false
  test_mode: false
  
  # Simulation
  simulate_traffic: false
  simulation_packet_rate: 100  # Packets per second
  
  # Testing
  enable_unit_tests: true
  enable_integration_tests: true
